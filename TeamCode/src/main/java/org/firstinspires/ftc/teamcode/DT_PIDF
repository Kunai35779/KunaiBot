package org.firstinspires.ftc.teamcode;

import static com.qualcomm.robotcore.hardware.DcMotor.ZeroPowerBehavior.BRAKE;

import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.PIDFCoefficients;

@TeleOp(name = "DT2", group = "BioBuzz")
public class DT2 extends OpMode {
    // Drivetrain
    private DcMotor fl, bl, fr, br;
    // private IMU imu;
    private final double maxSpeed = 1.0;

    private static final double FRONT_OFFSET = Math.PI;

    // Intake
    private DcMotor intake;
    private CRServo ls, rs;

    private CRServo transfer;

    // Shooter (always runs in velocity mode)
    private DcMotorEx shooter;

    private double kP = 65;
    private double kI = 1.0;
    private double kD = 0.0;
    private double kF = 75.32;
    private double targetVelocity = 1000;   // ticks per second
    private double stepSize = 0.1;

    private boolean tuning = false;
    private int selected = 0;      // 0=P 1=I 2=D 3=F 4=Target
    private static final String[] NAMES = {"P", "I", "D", "F", "Target vel"};

    private boolean lastBack, lastLeft, lastRight, lastUp, lastDown, lastLb, lastRb;

    @Override
    public void init() {
        // DT:
        fl = hardwareMap.get(DcMotor.class, "fl");
        bl = hardwareMap.get(DcMotor.class, "bl");
        fr = hardwareMap.get(DcMotor.class, "fr");
        br = hardwareMap.get(DcMotor.class, "br");

        fl.setDirection(DcMotorSimple.Direction.REVERSE);
        bl.setDirection(DcMotorSimple.Direction.REVERSE);
        fr.setDirection(DcMotorSimple.Direction.FORWARD);
        br.setDirection(DcMotorSimple.Direction.REVERSE);

        fl.setZeroPowerBehavior(BRAKE);
        bl.setZeroPowerBehavior(BRAKE);
        fr.setZeroPowerBehavior(BRAKE);
        br.setZeroPowerBehavior(BRAKE);

        fl.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        bl.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        fr.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        br.setMode(DcMotor.RunMode.RUN_USING_ENCODER);

        // Int
        intake = hardwareMap.get(DcMotor.class, "intake");
        ls = hardwareMap.get(CRServo.class, "ls");
        rs = hardwareMap.get(CRServo.class, "rs");

        ls.setDirection(DcMotorSimple.Direction.FORWARD);

        telemetry.addData("Status", "Initialized");

        //Transfer
        transfer = hardwareMap.get(CRServo.class, "transfer");

        telemetry.addData("Initialized", "Transfer");

        //Shooter
        shooter = hardwareMap.get(DcMotorEx.class, "shooter");

        shooter.setDirection(DcMotorSimple.Direction.FORWARD);
        shooter.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        shooter.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        applyPIDF();

        telemetry.addData("Shooter", "Initialized");
    }

    @Override
    public void loop() {

        // FC
        double y = -gamepad1.left_stick_y;
        double x = gamepad1.left_stick_x;
        double rx = -gamepad1.right_stick_x;


        // New
        double flPower = y + x + rx;
        double blPower = y - x + rx;
        double frPower = y - x - rx;
        double brPower = y + x - rx;

        double maxPower = 1.0;
        maxPower = Math.max(maxPower, Math.abs(flPower));
        maxPower = Math.max(maxPower, Math.abs(blPower));
        maxPower = Math.max(maxPower, Math.abs(frPower));
        maxPower = Math.max(maxPower, Math.abs(brPower));

        fl.setPower(maxSpeed * (flPower / maxPower));
        bl.setPower(maxSpeed * (blPower / maxPower));
        fr.setPower(maxSpeed * (frPower / maxPower));
        br.setPower(maxSpeed * (brPower / maxPower));

        // Int
        double intakePower = 1.0;

        intake.setPower(intakePower);
        ls.setPower(intakePower);
        rs.setPower(intakePower);

        //Transfer
        double transfer_power = gamepad1.left_trigger;

        transfer.setPower(transfer_power);

        updateTuner();
        shooter.setVelocity(targetVelocity);

        shooterTelemetry();
    }

    @Override
    public void stop() {
        fl.setPower(0);
        bl.setPower(0);
        fr.setPower(0);
        br.setPower(0);
        intake.setPower(0);
        ls.setPower(0);
        rs.setPower(0);
        transfer.setPower(0);
        shooter.setPower(0);
    }

    private void applyPIDF() {
        shooter.setPIDFCoefficients(DcMotor.RunMode.RUN_USING_ENCODER,
                new PIDFCoefficients(kP, kI, kD, kF));
    }

    private void updateTuner() {
        boolean back = gamepad1.back;
        boolean left = gamepad1.dpad_left;
        boolean right = gamepad1.dpad_right;
        boolean up = gamepad1.dpad_up;
        boolean down = gamepad1.dpad_down;
        boolean lb = gamepad1.left_bumper;
        boolean rb = gamepad1.right_bumper;

        if (back && !lastBack) {
            tuning = !tuning;
        }

        if (tuning) {
            if (right && !lastRight) selected = (selected + 1) % NAMES.length;
            if (left && !lastLeft) selected = (selected + NAMES.length - 1) % NAMES.length;

            if (rb && !lastRb) stepSize *= 10;
            if (lb && !lastLb) stepSize /= 10;

            double delta = 0;
            if (up && !lastUp) delta = 1;
            if (down && !lastDown) delta = -1;

            if (delta != 0) {
                switch (selected) {
                    case 0: kP += delta * stepSize; break;
                    case 1: kI += delta * stepSize; break;
                    case 2: kD += delta * stepSize; break;
                    case 3: kF += delta * stepSize; break;
                    case 4: targetVelocity += delta * 50; break;
                }
                kP = Math.max(0, kP);
                kI = Math.max(0, kI);
                kD = Math.max(0, kD);
                kF = Math.max(0, kF);
                targetVelocity = Math.max(0, targetVelocity);
                applyPIDF();
            }
        }

        lastBack = back;
        lastLeft = left;
        lastRight = right;
        lastUp = up;
        lastDown = down;
        lastLb = lb;
        lastRb = rb;
    }

    private void shooterTelemetry() {
        telemetry.addData("Shooter", "Velocity mode (always on)");
        telemetry.addData("Velo", "%.0f ticks/s", shooter.getVelocity());
        telemetry.addData("Target", "%.0f", targetVelocity);
        telemetry.addData("Error", "%.0f", targetVelocity - shooter.getVelocity());
        if (tuning) {
            telemetry.addLine();
            telemetry.addData("Tuner", "ON (BACK to lock)");
            telemetry.addData((selected == 0 ? "> " : "  ") + "P", "%.4f", kP);
            telemetry.addData((selected == 1 ? "> " : "  ") + "I", "%.4f", kI);
            telemetry.addData((selected == 2 ? "> " : "  ") + "D", "%.4f", kD);
            telemetry.addData((selected == 3 ? "> " : "  ") + "F", "%.4f", kF);
            telemetry.addData((selected == 4 ? "> " : "  ") + "Target (step 50)", "%.0f", targetVelocity);
            telemetry.addData("Step size", stepSize);
        } else {
            telemetry.addLine("Tuner locked. Press BACK to edit PIDF/target");
        }
        telemetry.update();
    }
}
